# Production only: the local stack needs no .env. On the VPS these live in the
# operator-owned /opt/saga-lab/.env; GitHub Actions never sees them. Use long,
# unique, URL-safe secrets: the service passwords are embedded in connection URLs.
# PostgreSQL and RabbitMQ apply them only when their data volumes are first created.
POSTGRES_PASSWORD=<postgres superuser secret>
TRANSFER_SERVICE_DB_PASSWORD=<transfer_service role secret>
BANK_A_DB_PASSWORD=<bank_a role secret>
BANK_B_DB_PASSWORD=<bank_b role secret>
RABBITMQ_USER=saga_lab
RABBITMQ_PASSWORD=<rabbitmq secret>
GRAFANA_ADMIN_PASSWORD=<grafana admin secret>

# The deployment writes .env.image beside .env:
# SAGA_LAB_IMAGE=ghcr.io/dvinubius/saga-lab@sha256:<digest>
