{
  "uid": "broker",
  "title": "Broker",
  "tags": [
    "saga-lab"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CreditFunds",
      "description": "Bank B's normal credit queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "interval": "1s",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "unit": "none",
          "custom": {
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_ready{queue=\"CreditFunds\"}",
          "legendFormat": "ready",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_messages_unacked{queue=\"CreditFunds\"}",
          "legendFormat": "unacknowledged",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rabbitmq_queue_consumers{queue=\"CreditFunds\"}",
          "legendFormat": "consumers",
          "range": true
        }
      ]
    },
